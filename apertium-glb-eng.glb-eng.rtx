!!!!!!!!!!!!!!!
!! ATTRIBUTE CATEGORIES
!!!!!!!!!!!!!!!

number = sg pl sp ND;
gender_ENG = m f mf nt GD;
gender_GLB = m f ut nt GD;
det_type = def ind dem itg pos;
definite = def ind;
copula = vbser vblex;
articles = the a an;
degree = comp sup;
person = p1 p2 p3;
personlex = p3;
numbervblex = sg;
prespast = pres past;
futcondi = fut cni;
modal = abil ingay musi;
case = subj obj;
prn_subtype = ref rel ind dem;
finite = pres past fut cni imp;
aspect = prog impf pros;
tense = [finite] inf pprs ger pp;
preflist = aw ex per;

!!!!!!!!!!!!!!!
!! OUTPUT PATTERNS
!!!!!!!!!!!!!!!



n: _.number;
adj: _.degree.det_type.number;
pr: _;
adv: _;
num: _.number;
prn: _.case.det_type.prn_subtype.person.gender_ENG.number;
det: _.det_type.number;
det_default: _.det_type;
det_def: _.det_type.number;
vblex: _.tense.person.number;
vbdo: _.tense.person.number;
vbpr: _.tense.aspect;
vbmod: _.tense.person.number;
vbser: _.tense.person.number;

NP: _.number;

npcomp: _.number;
NNP: _.number;
CNP: _;
DP: _;
NOM: _;
CONJ: _;

AP: _;
AJ: _.degree;
AJC: _;
AVP: _;

! tense is an output of the verbal phrases so that the information can be used for determining the tense marker in the Globasa.

WILL: _.tense;
BE: _.tense;
HAVE: _.tense;
VP: _.tense;
VPser: _.tense.person.number;
PVP: _.tense.person.number;
DVP: _.tense.person.number;
PRN: _.person.gender_ENG.number;
S: _;

REL: _;

!!!!!!!!!!!!!!!
!! TAG-REWRITE RULES
!!!!!!!!!!!!!!!

tense > tense : ifi past, pri pres, fti fut;
tense > tense_PP : fut pres, cni past;

!!!!!!!!!!!!!!!
!! MACROS
!!!!!!!!!!!!!!!

det: (if (1.det_type = def or 1.det_type = ind)
         1(det_def)
      else
         1(det_default));

!!!!!!!!!!!!!!!
!! REDUCTION RULES
!!!!!!!!!!!!!!!

! Accounts for any number of adverbs
AVP -> 0.1:adj.ord AVP { 1 _ 2 }  |
       adj.ord { 1 } |
       0.1:adv AVP { 1 _ 2 }  |
       adv { 1 } ; 

       ! Accounts for any number of adjectival phrases and carries forth the comparative degree to later convert to an adverb.
AJ -> AVP adj.$degree { 1 _ 2 } |
      adj.$degree { 1 } ;

! Coverts the comparative degree into an adverb.
AJC ->      maxmo@adv AJ { 2[degree=comp] }|
            maxim@adv AJ { 2[degree=sup] }|
            AJ { 1  };

! Accounts for any number of adjectival phrases including comparisons.
AP -> AJC AP { 1 _ 2 } |
      AJC { 1 } ;

VP -> vblex.$tense { %1[person=$person, number=$number] }| AVP vblex.$tense { 1 _ %2[person=$person, number=$number] };

VPser -> vbser.$tense.$person.$number { %1[person=$person, number=$number] }|
         AVP vbser.$tense.$person.$number { 1 _ %2[person=$person, number=$number] };

NP -> %n {%1[number=$number]}|
      adj %NP {1 _ %2[number=$number]};

NNP -> %NP {%1[number=sg]}|
      %num NP {1 %2[number=pl]}|
      5: %un@num NP {%2[number=sg]}|
      plu@adj %NP {%2[number=pl]};

NOM -> NNP {1}| prn {1};

DVP ->   u@vbpr.[prespast] %VP {  %2[tense=1.tense, person=$person, number=$number] }|
         u@vbpr.[futcondi] %VP {  will@vbmod.[1.tense>tense_PP] _ %2[tense = inf, person=$person, number=$number] }|
         u@vbpr.imp %VP { %2[tense = imp, person=$person, number=$number] }|
         5: u@vbpr.inf %VP { to@pr _  2[tense=inf] }|
         [modal]@vbmod.$tense u@vbpr.inf %VP { 1[tense=pres] _  3[tense=2.tense] }|
         u@vbpr.[prespast] %VPser {  %2[tense=1.tense, person=$person, number=$number] }|
         u@vbpr.[futcondi] %VPser {  will@vbmod.[1.tense>tense_PP] _ %2[tense = inf, person=$person, number=$number] }|
         u@vbpr.imp %VPser { %2[tense = imp, person=$person, number=$number] }|
         5: u@vbpr.inf %VPser { to@pr _  2[tense=inf] }|
         [modal]@vbmod.$tense u@vbpr.inf %VPser { 1[tense=pres] _  3[tense=2.tense] }|
         0.01: %VP
         (if (1.tense = pprs | 1.tense = pp) {  %1[tense=1.tense, person=$person, number=$number] }
            else {  %1[tense=pres, person=$person, number=$number] }
            )|
         0.01: %VPser { %1[tense=pres, person=$person, number=$number] }
;

S -> NNP %DVP (if (1.number = pl) {1 _ %2[person=p3,number=pl]} else {1 _ %2[person=p3,number=sg]})|
     NNP %DVP ke@prn {3 _  2 _ 1}|
     10: AP NNP %DVP ke@prn {4 _  3 _ 1 _ 2}|
     hu@cnjsub da@prn %DVP {who@cnjsub _ %3[person=p3,number=sg]}|
     hu@cnjsub da@prn AVP %DVP {who@prn.rel.an.mf.sp _ 3 _ %4[person=p3,number=sg]}|
     hu@cnjsub AVP da@prn %DVP {who@prn.rel.an.mf.sp _ 2 _ %4[person=p3,number=sg]}|
     hu@cnjsub NNP %DVP da@prn  {whom@prn.rel.an.mf.sp _ 2 _ %3[person=p3,number=sg]}|
     prpers@prn %DVP {1[case=subj] _ %2[person=1.person, number=1.number]}|
     prpers@prn %DVP prpers@prn {1[case=subj] _ %2[person=1.person, number=1.number] _ 3[case=obj]}|
     prpers@prn %DVP pr prpers@prn {1[case=subj] _ %2[person=1.person, number=1.number] _ 3 _ 4[case=obj]}|
     kam@cnjcoo NOM u@vbpr.[futcondi] VP { will@vbmod.[3.tense>tense_PP] _ 2 _ %4[tense=inf] }|
     kam@cnjcoo NNP u@vbpr.[prespast] VP { do@vbdo[tense=3.tense, person=p3, number=2.number] _ 2 _ %4[tense=inf] }|
     kam@cnjcoo NNP VP { do@vbdo[tense=pres, person=p3, number=2.number] _ 2 _ %3[tense=inf] }|
     kam@cnjcoo prpers@prn u@vbpr.[prespast] %VP {do@vbdo[tense=3.tense, person=2.person, number=2.number] _ 2[case=subj] _ %4[tense=inf]}|
     kam@cnjcoo prpers@prn u@vbpr.[prespast] %VP prpers@prn {do@vbdo[tense=3.tense, person=2.person, number=2.number] _ 2[case=subj] _ %4[tense=inf] _ 5[case=obj]}|
     kam@cnjcoo prpers@prn u@vbpr.[prespast] %VP pr prpers@prn {do@vbdo[tense=3.tense, person=2.person, number=2.number] _ 2[case=subj] _ %4[tense=inf] _ 5 _ 6[case=obj]}
;

! Example rule:
! Input:  ^ראש<n><m><sg>/hovud<n><nt><sg>$ ^גדול<adj><m><sg>/stor<adj><m><sg>$
! Output: ^stor<adj><nt><sg>$ ^hovud<n><nt><sg>$
! NP -> n.$number adj { 2[gender=1.gender, number=1.number] _ 1 } ;

! Resources:
! https://wiki.apertium.org/wiki/Apertium-recursive
! https://wiki.apertium.org/wiki/Apertium-recursive/Formalism
! https://wiki.apertium.org/wiki/Apertium-recursive/Cookbook
