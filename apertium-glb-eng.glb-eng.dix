<?xml version="1.0" encoding="UTF-8"?>
<dictionary>
   <!-- Define the alphabet below. -->
  <alphabet>aAáÁăảạÆbBcCčdDÐeEéèễệfFgGhHiIíjJkKlLmMnNoOóöớpPqQrRsSšştTŢuUúüưvVwWxXyYzZ</alphabet>

  <sdefs>
    <!-- Define symbol definitions within <sdef> here. -->
    <sdef n="n"               c="Noun"/>
    <sdef n="np"              c="Proper noun"/>
    <sdef n="vblex"           c="Verb, lexical"/>
    <sdef n="vbmod"           c="Modal verb"/>
    <sdef n="vaux"            c="Auxiliary verb"/>
    <sdef n="vbdo"           c="'do' support verb"/>
    <sdef n="vbser"           c="'To be' verb"/>
    <sdef n="vbhaver"         c="'To have' verb"/>
    <sdef n="vbpr"           c="Verbal preposition"/>
    <sdef n="cnjsub"          c="Subordinating conjunction"/>
    <sdef n="cnjcoo"          c="Co-ordinating conjunction"/>
    <sdef n="cnjadv"          c="Adverbial conjunction"/>
    <sdef n="pr"              c="Preposition"/>
    <sdef n="adv"             c="Adverb"/>
    <sdef n="preadv"          c="Preadverb"/>
    <sdef n="ij"              c="Interjection"/>
    <sdef n="adj"             c="Adjective"/>
    <sdef n="prn"             c="Pronoun"/>

    <sdef n="pfx"             c="Prefix"/>
    

    <sdef n="attr"            c="Attributive"/>
    <sdef n="top"             c="Toponym"/>
    <sdef n="ant"             c="Anthroponym"/>
    <sdef n="cog"             c="Cognomen"/>
    <sdef n="org"             c="Organisation"/>
    <sdef n="al"              c="Altres / misc proper nouns"/>

    <sdef n="pers"            c="Personal pronoun"/>
    <sdef n="ref"             c="Reflexive pronoun"/>
    <sdef n="res"             c="Reciprocal pronoun"/>

    <sdef n="det"             c="Determiner"/>
    <sdef n="pos"             c="Possessive"/>

    <sdef n="p1"              c="1st person"/>
    <sdef n="p2"              c="2nd person"/>
    <sdef n="p3"              c="3rd person"/>

    <sdef n="nt"              c="Neuter"/>
    <sdef n="ut"              c="Utrum"/>
    <sdef n="f"               c="Feminine"/>
    <sdef n="m"               c="Masculine"/>
    <sdef n="mf"               c="Masculine or Feminine"/>
    <sdef n="un"              c="No gender"/>
    <sdef n="GD"              c="Gender to be determined"/>

    <sdef n="sg"              c="Singular"/>
    <sdef n="du"              c="Dual"/>
    <sdef n="pl"              c="Plural"/>
    <sdef n="sp"              c="Singular / plural"/>

    <sdef n="ind"             c="Indefinite"/>
    <sdef n="def"             c="Definite"/>

    <sdef n="nom"             c="Nominative"/>
    <sdef n="acc"             c="Accusative"/>
    <sdef n="gen"             c="Genitive"/>

    <sdef n="obj" 	c="Object"/> 
    <sdef n="subj" 	c="Subject"/> 

    <sdef n="dem"             c="Demonstrative"/>
    <sdef n="itg"             c="Question word / interrogative"/>
    <sdef n="qnt"             c="Quantifier"/>
    <sdef n="aff"             c="Affirmative" />
    <sdef n="neg"             c="Negative"/>
    <sdef n="emph"            c="Emphatic"/>

    <sdef n="inf"             c="Infinitive"/>
    <sdef n="pres"            c="Present"/>
    <sdef n="imp"             c="Imperative"/>
    <sdef n="pret"            c="Preterite"/>
    <sdef n="past"            c="Past"/>
    <sdef n="fut"             c="Future"/>
    <sdef n="cni"             c="Conditional"/>
    <sdef n="pp"              c="Perfect participle"/>
    <sdef n="pprs"            c="Present participle"/>
    <sdef n="pasv"            c="Passive"/>
    <sdef n="actv"            c="Active voice"/>

    <sdef n="sint"            c="Synthetic (of adjectives)"/>
    <sdef n="pst"             c="Positive"/>
    <sdef n="comp"            c="Comparative"/>
    <sdef n="sup"             c="Superlative"/>

    <sdef n="ord"             c="Ordinal"/>
    <sdef n="acr"             c="Acronym"/>
    <sdef n="unc"             c="Uncountable"/>

    <sdef n="num"             c="Numeral"/>
    <sdef n="sent"            c="Sentence end"/>
    <sdef n="cm"              c="Comma"/>
    <sdef n="apos"            c="Apostrophe"/>
    <sdef n="guio"            c="Dash"/>
    <sdef n="lpar"            c="Left parenthesis"/>
    <sdef n="rpar"            c="Right parenthesis"/>
    <sdef n="lquot"           c="Left quote"/>
    <sdef n="rquot"           c="Right quote"/>

    <sdef n="compound-only-L" c="May only be the left-side of a compound"/>
    <sdef n="compound-R"      c="May be the right-side of a compound, or a full word"/>
  </sdefs>

   <section id="main" type="standard">
      <!-- Define entries within <e> here. -->
      <!-- example:
           <e><p><l>house<s n="n"/></l><r>casa<s n="n"/><s n="f"/></r></p></e>
      -->

      <e><re>[.\?;:!…¿¶]</re><p><l><s n="sent"/></l><r><s n="sent"/></r></p></e>
      <e><re>,</re>          <p><l><s n="cm"/></l>  <r><s n="cm"/></r></p></e>


    <!-- Co-ordinating conjunction -->
  <!-- According to http://en.wikipedia.org/wiki/Co-ordinating_conjunction :
       after, although, if, unless, so that, and because  -->

<e>       <p><l>ji<s n="cnjcoo"/></l>                 <r>and<s n="cnjcoo"/></r></p></e>
<e>       <p><l>iji<s n="cnjcoo"/></l>                 <r>both<s n="cnjcoo"/></r></p></e>



<e>       <p><l>moydua<s n="det"/><s n="ind"/><s n="pl"/><j/>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l>                 <r>both<s n="prn"/><s n="ind"/><s n="mf"/><s n="pl"/></r></p></e>


    <!-- the following are solely here to enable the rule   SN V SN "and also" SN -> SN V SN<acc> "and also" SN<acc>   match -->
<e>       <p><l>ji<b/>pia<s n="cnjcoo"/></l>           <r>and<b/>also<s n="cnjcoo"/></r></p></e>
<e>       <p><l>mas<b/>pia<s n="cnjcoo"/></l>          <r>but<b/>also<s n="cnjcoo"/></r></p></e>
<e>       <p><l>kom<s n = "cnjsub"/></l>               <r>as<s n = "cnjsub"/></r></p></e>
<e>       <p><l>kom<s n="cnjcoo"/></l>                 <r>than<s n="cnjsub"/></r></p></e>
<e>       <p><l>mas<s n="cnjcoo"/></l>                 <r>but<s n="cnjcoo"/></r></p></e>
<e>       <p><l>kam<s n = "cnjcoo"/></l>               <r><s n = "cnjcoo"/></r></p></e>
<e>       <p><l>or<s n="cnjcoo"/></l>                  <r>or<s n="cnjcoo"/></r></p></e>
<e r="RL"><p><l>oro<s n="cnjcoo"/></l>                 <r>either<s n="cnjcoo"/></r></p></e>
<e>       <p><l>nor<s n="cnjcoo"/></l>                 <r>neither<s n="cnjcoo"/></r></p></e>
<e r="RL"><p><l>nor<s n="cnjcoo"/></l>                 <r>nor<s n="cnjcoo"/></r></p></e>
<e>       <p><l>mas<b/>prefere<s n="cnjcoo"/></l>      <r>but<b/>rather<s n="cnjcoo"/></r></p></e>
<e>       <p><l>nenkom<s n = "cnjcoo"/></l>            <r>unlike<s n = "cnjcoo"/></r></p></e>
<e>       <p><l>poskom<s n = "cnjcoo"/></l>            <r>unlike<s n = "cnjcoo"/></r></p></e>
<e>       <p><l>alopul<b/>kom<s n = "cnjcoo"/></l>     <r>unlike<s n = "cnjcoo"/></r></p></e>
<e>       <p><l>denpul<b/>kom<s n = "cnjcoo"/></l>     <r>as<s n = "cnjcoo"/></r></p></e>
<e>       <p><l>denpul<b/>kom<s n = "cnjcoo"/></l>     <r>such<b/>as<s n = "cnjcoo"/></r></p></e>
<e>       <p><l>denpul<b/>kom<s n = "cnjcoo"/></l>     <r>like<s n = "cnjcoo"/></r></p></e>

<e r="LR"><p><l>u<s n="vbpr"/></l><r></r></p></e>

<e>  <p><l>si<s n="ij"/></l>     <r>yes<s n="ij"/></r></p></e>
<e>  <p><l>no<s n="ij"/></l>     <r>no<s n="ij"/></r></p></e>

<e>  <p><l>si<s n="adv"/></l>     <r>indeed<s n="ij"/></r></p></e>
<e>  <p><l>no<s n="adv"/></l>     <r>not<s n="ij"/></r></p></e>

    
        <!-- Co-ordinating conjunction 
<e>       <p><l>no<s n="adv"/><s n="fut"/></l>                 <r>not<s n="adv"/></r></p></e>
<e>       <p><l>u<s n="vbpr"/><s n="fut"/></l>                 <r>will<s n="vbmod"/><s n="pres"/></r></p></e>
<e>       <p><l>u<s n="vbpr"/><s n="cni"/></l>                 <r>will<s n="vbmod"/><s n="past"/></r></p></e>
-->
<e>       <p><l>aw<s n="pfx"/></l>                 <r>away<s n="adv"/></r></p></e>
<e>       <p><l>ex<s n="pfx"/></l>                 <r>out<s n="adv"/></r></p></e>
<e>       <p><l>per<s n="pfx"/></l>                 <r>on<s n="adv"/></r></p></e>
<e>       <p><l>per<s n="pfx"/></l>                 <r>over<s n="adv"/></r></p></e>

<e>       <p><l>xafe<s n = "pr"/><b/>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l>                 <r>then<s n="cnjadv"/></r></p></e>

<e>       <p><l>xafe<s n = "pr"/><b/>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l>                 <r>and<s n="cnjcoo"/><j/>then<s n="cnjadv"/></r></p></e>

<e><p><l>kom<s n = "pr"/></l>   <r>as<s n = "pr"/></r></p></e>
<e><p><l>kom<s n = "cnjcoo"/></l>   <r>than<s n = "cnjsub"/></r></p></e>

<!-- Bare prepositions -->
<e><p><l>in<s n="pr"/></l>   <r>in<s n="pr"/></r></p></e>
<e><p><l>tas<s n="pr"/></l>   <r>to<s n="pr"/></r></p></e>
<e><p><l>de<s n="pr"/></l>   <r>of<s n="pr"/></r></p></e>
<e><p><l>fe<s n="pr"/></l>   <r>at<s n="pr"/></r></p></e>
<e><p><l>el<s n="pr"/></l>   <r>el<s n="pr"/></r></p></e>

<!-- Quantifier -->
<e><p><l>multi<s n="adj"/></l>   <r>many<s n="adj"/></r></p></e>
<e><p><l>multi<s n="adv"/></l>   <r>much<s n="adv"/></r></p></e>

<!-- Cardinal numbers: units, tens -->
<e><p><l>un<s n="num"/></l>   <r>one<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>dua<s n="num"/></l>   <r>two<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>tiga<s n="num"/></l>   <r>three<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>care<s n="num"/></l>   <r>four<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>lima<s n="num"/></l>   <r>five<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>sisa<s n="num"/></l>   <r>six<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>sabe<s n="num"/></l>   <r>seven<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>oco<s n="num"/></l>   <r>eight<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>nue<s n="num"/></l>   <r>nine<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>des<s n="num"/></l>   <r>ten<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>duades<s n="num"/></l>   <r>twenty<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>tigades<s n="num"/></l>   <r>thirty<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>caredes<s n="num"/></l>   <r>forty<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>limades<s n="num"/></l>   <r>fifty<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>sisades<s n="num"/></l>   <r>sixty<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>sabedes<s n="num"/></l>   <r>seventy<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>ocodes<s n="num"/></l>   <r>eighty<s n="num"/><s n="sp"/></r></p></e>
<e><p><l>nuedes<s n="num"/></l>   <r>ninety<s n="num"/><s n="sp"/></r></p></e>

<e>       <p><l>moydua<s n="det"/><s n="ind"/><s n="pl"/><j/>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l>                 <r>both<s n="prn"/><s n="ind"/><s n="mf"/><s n="pl"/></r></p></e>


<e><p><l>triunfa<s n = "vblex"/></l>   <r>triumph<s n = "vblex"/></r></p></e>

<e><p><l>celki<s n = "cnjsub"/></l>   <r>so<b/>that<s n = "cnjsub"/></r></p></e>
<e><p><l>celki<s n = "cnjsub"/></l>   <r>in<b/>order<b/>for<s n = "cnjsub"/></r></p></e>
<e><p><l>denmaner<b/>hu<s n = "cnjsub"/></l>   <r>like<s n = "cnjsub"/></r></p></e>
<e><p><l>denmaner<b/>hu<s n = "cnjsub"/></l>   <r>in<b/>the<b/>way<b/>that<s n = "cnjsub"/></r></p></e>
<e><p><l>denwatu<s n="adv"/><j/>hu<s n = "cnjsub"/></l>   <r>whenever<s n = "cnjsub"/></r></p></e>
<e><p><l>durki<s n = "cnjsub"/></l>   <r>while<s n = "cnjsub"/></r></p></e>
<e><p><l>eger<s n = "cnjsub"/></l>   <r>if<s n = "cnjsub"/></r></p></e>
<e><p><l>eger<b/>no<s n = "cnjsub"/></l>   <r>if<b/>not<s n = "cnjsub"/></r></p></e>
<e><p><l>eger<b/>no<s n = "cnjsub"/></l>   <r>otherwise<s n = "cnjsub"/></r></p></e>
<e><p><l>eger<b/>si<s n = "cnjsub"/></l>   <r>if<b/>so<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>folo<b/>ki<s n = "cnjsub"/></l>   <r>such<b/>that<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>hataya<b/>ki<s n = "cnjsub"/></l>   <r>even<b/>though<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>hataya<b/>ki<s n = "cnjsub"/></l>   <r>although<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>hataya<b/>ki<s n = "cnjsub"/></l>   <r>despite<b/>the<b/>fact<b/>that<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>kompara<b/>ki<s n = "cnjsub"/></l>   <r>whereas<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>kosa<b/>ki<s n = "cnjsub"/></l>   <r>because<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>kosa<b/>ki<s n = "cnjsub"/></l>   <r>since<s n = "cnjsub"/></r></p></e>
<e><p><l>fe<b/>tayti<b/>ki<s n = "cnjsub"/></l>   <r>instead<b/>of<s n = "cnjsub"/></r></p></e>
<e><p><l>feki<s n = "cnjsub"/></l>   <r>that<s n = "cnjsub"/></r></p></e>
<e><p><l>finki<s n = "cnjsub"/></l>   <r>until<s n = "cnjsub"/></r></p></e>
<e><p><l>folki<s n = "cnjsub"/></l>   <r>the<b/>more<s n = "cnjsub"/></r></p></e>
<e><p><l>folki<s n = "cnjsub"/></l>   <r>the<b/>less<s n = "cnjsub"/></r></p></e>
<e><p><l>ki<s n = "cnjsub"/></l>   <r>that<s n = "cnjsub"/></r></p></e>
<e><p><l>koski<s n = "cnjsub"/></l>   <r>because<s n = "cnjsub"/></r></p></e>
<e><p><l>koski<s n = "cnjsub"/></l>   <r>since<s n = "cnjsub"/></r></p></e>
<e><p><l>ku<s n = "cnjsub"/></l>   <r>_interrogative<b/>clauses<b/>in<b/>declarative<b/>sentences_<s n = "cnjsub"/></r></p></e>
<e><p><l>kwas<s n = "cnjsub"/></l>   <r>as<b/>if<s n = "cnjsub"/></r></p></e>
<e><p><l>leki<s n = "cnjsub"/></l>   <r>before<s n = "cnjsub"/></r></p></e>
<e><p><l>temki<s n = "cnjsub"/></l>   <r>that<s n = "cnjsub"/></r></p></e>
<e><p><l>temki<s n = "cnjsub"/></l>   <r>about<b/>which<s n = "cnjsub"/></r></p></e>
<e><p><l>xaki<s n = "cnjsub"/></l>   <r>after<s n = "cnjsub"/></r></p></e>
<e><p><l>xaki<s n = "cnjsub"/></l>   <r>once<s n = "cnjsub"/></r></p></e>
<e><p><l>xorki<s n = "cnjsub"/></l>   <r>since<s n = "cnjsub"/></r></p></e>


<e><p><l>kama<s n = "cnjsub"/></l>       <r>whether<s n = "cnjsub"/></r></p></e>

<e>       <p><l>su<s n="pos"/></l>                 <r>'s<s n="gen"/></r></p></e>
    
    <!-- Personal pronouns -->


<e>       <p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p1"/><s n="mf"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p2"/><s n="mf"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p3"/><s n="f"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p3"/><s n="f"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p3"/><s n="m"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p3"/><s n="m"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p3"/><s n="nt"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="pl"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p1"/><s n="mf"/><s n="pl"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="pl"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p2"/><s n="mf"/><s n="pl"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p3"/><s n="mf"/><s n="pl"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="subj"/><s n="p2"/><s n="mf"/><s n="sp"/></r></p></e>

<e>       <p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="obj"/><s n="p1"/><s n="mf"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="obj"/><s n="p2"/><s n="mf"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p3"/><s n="f"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="obj"/><s n="p3"/><s n="f"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p3"/><s n="m"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="obj"/><s n="p3"/><s n="m"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>prpers<s n="prn"/><s n="obj"/><s n="p3"/><s n="nt"/><s n="sg"/></r></p></e>
<e>       <p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="pl"/></l><r>prpers<s n="prn"/><s n="obj"/><s n="p1"/><s n="mf"/><s n="pl"/></r></p></e>
